{
  "name": "vps-pulse-monitor",
  "version": "1.0.0",
  "description": "Lightweight HTTP/TCP availability and p50/p95 latency monitor with SQLite storage, state-change webhooks, and embedded web dashboard",
  "type": "module",
  "bin": {
    "vps-pulse": "./dist/cli.js"
  },
  "author": "Carlos Almonte <carlos@haarls.dev> (https://haarls.dev)",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "once": "tsx src/cli.ts --once",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.1.1"
  }
}
